"""post-checkout hook entrypoint (shebang written by install.py at install time).

Per contracts/git-hooks.md §post-checkout:
1. no-op unless the third argument is ``1`` (branch checkout, not file checkout);
2. call ``_snapshot.snapshot()`` on the current working directory and pass the
   new HEAD so the snapshot helper can identify a tracked parent worktree;
3. when a tracked branch is now checked out and its graph is missing or stale,
   refresh it, so switching onto ``main`` never leaves an outdated graph behind;
4. **always exit 0**, regardless of whether the copy or refresh succeeded — the
   checkout has already happened and this hook must never affect its outcome.

Git invokes this hook with ``<prev-head-sha> <new-head-sha> <branch-checkout-flag>``.
"""

from __future__ import annotations

import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent
if str(_HERE) not in sys.path:
    sys.path.insert(0, str(_HERE))

import _refresh  # noqa: E402
import _snapshot  # noqa: E402
import _tracked_branches  # noqa: E402


def main(argv: list[str]) -> int:
    if len(argv) < 4 or argv[3] != "1":
        return 0
    _snapshot.snapshot(Path.cwd(), argv[2])
    root = _tracked_branches._repo_root(Path.cwd())
    if root is not None:
        _refresh.refresh_tracked_branch(root, "post-checkout", only_if_stale=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
